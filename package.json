{
  "name": "code-guardian",
  "version": "0.1.0",
  "private": true,
  "description": "AI 代码副作用检测与审查治理平台 —— 在 MR 合并前自动分析变更影响链路",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/analyze-core.test.cjs tests/rules.test.cjs tests/webhook-adapters.test.ts tests/semantic-graph.test.ts tests/enrich.test.ts tests/events.test.ts tests/dependency-manifest.test.ts tests/cve-scan.test.ts tests/bundle-size.test.ts tests/gitlab-status.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx --env-file=.env prisma/seed.ts",
    "fixture": "bash scripts/create-fixture.sh",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.19.3",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.4",
    "globals": "^17.12.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
