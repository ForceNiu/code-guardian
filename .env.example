# ── 数据库（Neon Postgres）─────────────────────────────────────
# 到 Neon 控制台新建一个 database，复制连接串（选 Pooled / 或 Unpooled 均可）
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ── 或：本地 Docker Postgres（离线兜底）────────────────────────
# 先 `docker compose up -d`，再用下面这条本地连接串替换上面的 DATABASE_URL：
# DATABASE_URL="postgresql://codeguardian:codeguardian@localhost:5432/code_guardian?schema=public"

# ── AI 语义引擎（可选）────────────────────────────────────────
# LangGraph.js 判定「规则引擎无法确定（uncertain）」的变更时调用；未填 = 跳过 AI 判定，报告照出
DEEPSEEK_API_KEY=""

# ── 出网代理（可选，DeepSeek 调用走代理时配置）──────────────
# deepseek.ts 刻意读取 HTTP_PROXY / HTTPS_PROXY（undici 不读代理会挂死，见 deepseek.ts 注释）
# 留空 = 直连
HTTP_PROXY=""
HTTPS_PROXY=""

# ── GitLab Commit Status 回写（可选，MR 合并红绿灯才需要）────
# 缺此项时静默跳过回写（不影响主分析链路），需要 api scope
GITLAB_TOKEN=""

# ── 写端点鉴权（fail-closed：两个都不配 = 两个写接口整段拒绝）──────
# 🔴 2026-09-16 起改为「安全默认」：**不配就拒绝**，而不是「不配就不校验」。
#    原因：分析链路会真调 DeepSeek 产生费用，敞开等于替别人付账。

# 手动触发（POST /api/tasks）访问口令。首页「触发分析」表单里要填这个值。
# 未配置 → 该接口返回 503，任何人都无法提交任务。
MANUAL_TRIGGER_TOKEN=""

# 平台 Webhook（POST /api/webhook）来源校验密钥。需要 api scope。
# 未配置 → 该接口返回 503（不再跳过校验）。
# GitLab 用 x-gitlab-token 比对；GitHub 用 HMAC-SHA256 签名比对。
WEBHOOK_SECRET=""
